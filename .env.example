# Public base URL of the deployed Midmar site (no trailing slash)
APP_BASE_URL=https://midmr.onrender.com

# Google OAuth 2.0 credentials from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact callback URL registered in Google Cloud Console
GOOGLE_REDIRECT_URI=https://midmr.onrender.com/auth/google/callback

# Google account that owns the existing legacy quizzes already in the database.
# Set this to the owner's verified Google email before first sign-in.
GOOGLE_OWNER_EMAIL=

# Set NODE_ENV=production in the hosting provider so secure cookies are enabled
NODE_ENV=production
