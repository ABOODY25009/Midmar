# Base public URL of the deployed Midmar site (no trailing slash)
APP_BASE_URL=https://your-domain.example

# Google OAuth 2.0 credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the callback URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI=https://your-domain.example/auth/google/callback

# Microsoft Entra ID app registration credentials
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Use "common" for work/school and personal Microsoft accounts, or a tenant ID
MICROSOFT_TENANT=common
# Must exactly match the callback URI registered in Microsoft Entra
MICROSOFT_REDIRECT_URI=https://your-domain.example/auth/microsoft/callback

# Set NODE_ENV=production in the hosting provider so secure cookies are enabled
NODE_ENV=production
